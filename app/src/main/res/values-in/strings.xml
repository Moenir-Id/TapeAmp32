    <string name="eq_tone_subtitle">PREAMP / BASS / TREBLE</string>
    <string name="eq_preamp_slider_label">PREAMP</string>
    <string name="eq_bass_slider_label">BASS</string>
    <string name="eq_treble_slider_label">TREBLE</string>
    <string name="eq_tone_description">Preamp mengatur gain keseluruhan sebelum masuk ke 10-band EQ. Bass/Treble di sini adalah pintasan langsung ke band 31Hz &amp; 16kHz — geser di tab EQU untuk kontrol penuh 10-band.</string>

    <string name="eq_limit_subtitle">SOFT LIMITER</string>
    <string name="eq_soft_limiter_label">SOFT LIMITER</string>
    <string name="eq_soft_limiter_desc">Menahan puncak sinyal secara halus (soft-knee, ambang sekitar -0.9 dBFS) supaya tidak clipping keras saat preset EQ boost besar.</string>
    <string name="eq_bypass_label">EQ BYPASS</string>
    <string name="eq_bypass_desc">Matikan sementara seluruh proses 10-band EQ (preamp &amp; band tetap tersimpan, tinggal nyalakan lagi kapan saja).</string>
    <string name="eq_bitperfect_label">BIT-PERFECT MODE</string>
    <string name="eq_bitperfect_desc">Lewati SEMUA proses sinyal software (EQ, Vocal, Balance, Stereo Expansion, Mono, Limiter) DAN minta jalur AUDIO OFFLOAD hardware ke device/USB DAC yang sedang nyambung. Posisi knop lain tidak ikut berubah, cuma dibekukan sementara. Dukungan offload tergantung device &amp; format lagu — kalau tidak didukung, otomatis fallback ke bypass software (tetap berfungsi penuh).</string>
    <string name="eq_autoeq_label">AUTO EQ PER LAGU</string>
    <string name="eq_autoeq_desc">Ingat preset EQ yang dipilih untuk tiap lagu, lalu pasang otomatis lagi begitu lagu itu diputar ulang — tidak perlu ganti preset manual tiap pindah lagu.</string>
    <string name="eq_replaygain_label">REPLAY GAIN</string>
    <string name="eq_replaygain_desc">Ukur &amp; samakan level (loudness) antar lagu secara otomatis — lagu yang belum pernah diputar akan diukur sambil didengarkan, lalu gain-nya diingat untuk pemutaran berikutnya. Otomatis nonaktif selagi BIT-PERFECT MODE menyala.</string>
    <string name="eq_crossfade_label">CROSSFADE</string>
    <string name="eq_crossfade_desc">Tumpuk-tenggelamkan (overlap) lagu sekarang dengan lagu berikutnya saat berpindah otomatis di akhir lagu — beda dari GAPLESS yang cuma menghilangkan jeda hening tanpa overlap.</string>

    <string name="eq_delete_short">HAPUS</string>
    <string name="eq_song_preset_saved">Lagu ini: preset “%1$s” tersimpan</string>
    <string name="eq_song_no_preset">Lagu ini belum punya preset tersimpan — pilih preset di atas</string>
    <string name="eq_song_replaygain_saved">Lagu ini: %1$s dB tersimpan</string>
    <string name="eq_song_replaygain_measuring">Lagu ini belum terukur — sedang diukur sambil diputar</string>
    <string name="eq_crossfade_duration_label">Durasi overlap:</string>
    <string name="eq_crossfade_seconds_unit">%1$dS</string>
    <string name="eq_offload_active">OFFLOAD hardware AKTIF — lagu ini benar-benar lewat jalur direct-path ke DAC.</string>
    <string name="eq_offload_inactive">OFFLOAD belum aktif untuk lagu ini — otomatis fallback ke bypass software (tetap bit-perfect).</string>
    <string name="eq_rocker_off">OFF</string>
    <string name="eq_rocker_on">ON</string>

    <string name="eq_vocal_subtitle">VOCAL BASS / TREBLE</string>
    <string name="eq_vocal_toggle_desc">Nyalakan penguat vokal — dua filter khusus (body ~200Hz &amp; kejernihan ~4.5kHz) terpisah dari 10-band EQ di tab EQU, supaya vokal lebih menonjol tanpa mengubah preset yang sedang dipakai.</string>
    <string name="eq_vocal_bass_knob">VOCAL BASS</string>
    <string name="eq_vocal_treble_knob">VOCAL TREBLE</string>
    <string name="eq_vocal_description">VOCAL BASS mengisi kehangatan vokal (~200Hz), VOCAL TREBLE menambah kejernihan/artikulasi (~4.5kHz) — keduanya independen dari BASS/TREBLE di tab NADA.</string>

    <string name="eq_stereo_subtitle">BALANCE / EXPANSION / MONO</string>
    <string name="eq_balance_knob">BALANCE</string>
    <string name="eq_stereo_expansion_knob">STEREO EXPANSION</string>
    <string name="eq_mono_stereo_label">MONO / STEREO</string>
    <string name="eq_mono_stereo_desc">Kalau ON, channel kiri &amp; kanan digabung jadi mono (L+R sama persis di kedua channel) — selalu mengalahkan Stereo Expansion. Kalau OFF, citra stereo asli/hasil Stereo Expansion tetap dipakai.</string>
    <string name="eq_stereo_description">BALANCE menggeser volume relatif kiri/kanan. STEREO EXPANSION melebarkan (&gt;100%%) atau menyempitkan (&lt;100%%) citra stereo lewat pemrosesan Mid/Side, 0%% sama dengan mono penuh.</string>

