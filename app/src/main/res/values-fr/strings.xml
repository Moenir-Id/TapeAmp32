    <string name="eq_graphic_equalizer_header">ÉGALISEUR GRAPHIQUE</string>
    <string name="eq_10_band">10 BANDES</string>

    <string name="eq_vu_level">NIVEAU</string>
    <string name="eq_lr_label">G / D</string>

    <string name="eq_tone_subtitle">PRÉAMPLI / GRAVES / AIGUS</string>
    <string name="eq_preamp_slider_label">PRÉAMPLI</string>
    <string name="eq_bass_slider_label">GRAVES</string>
    <string name="eq_treble_slider_label">AIGUS</string>
    <string name="eq_tone_description">Le préampli contrôle le gain global avant l\'égaliseur 10 bandes. Les curseurs Graves/Aigus ici sont un raccourci direct vers les bandes 31Hz et 16kHz — utilisez l\'onglet ÉGAL pour le contrôle complet des 10 bandes.</string>

    <string name="eq_limit_subtitle">LIMITEUR DOUX</string>
    <string name="eq_soft_limiter_label">LIMITEUR DOUX</string>
    <string name="eq_soft_limiter_desc">Retient doucement les pics du signal (courbe douce, seuil autour de -0,9 dBFS) afin que les fortes hausses d\'égalisation ne saturent pas brutalement.</string>
    <string name="eq_bypass_label">CONTOURNEMENT EQ</string>
    <string name="eq_bypass_desc">Désactive temporairement tout le traitement de l\'égaliseur 10 bandes (le préampli et les bandes restent enregistrés — réactivez-le à tout moment).</string>
    <string name="eq_bitperfect_label">MODE BIT-PERFECT</string>
    <string name="eq_bitperfect_desc">Ignore TOUT le traitement du signal logiciel (EQ, Voix, Balance, Expansion Stéréo, Mono, Limiteur) ET demande un chemin AUDIO OFFLOAD matériel vers l\'appareil/DAC USB connecté. Les autres réglages ne changent pas, ils sont simplement gelés temporairement. La prise en charge de l\'offload dépend de l\'appareil et du format de la chanson — si non pris en charge, le contournement logiciel est utilisé automatiquement (toujours pleinement fonctionnel).</string>
    <string name="eq_autoeq_label">AUTO EQ PAR CHANSON</string>
    <string name="eq_autoeq_desc">Mémorise le préréglage d\'égaliseur choisi pour chaque chanson, puis le réapplique automatiquement la prochaine fois qu\'elle sera jouée — plus besoin de changer de préréglage manuellement à chaque fois.</string>
    <string name="eq_replaygain_label">REPLAY GAIN</string>
    <string name="eq_replaygain_desc">Mesure et harmonise automatiquement le volume entre les chansons — une chanson pas encore mesurée est mesurée pendant l\'écoute, puis le gain est mémorisé pour la prochaine fois. Désactivé automatiquement lorsque le MODE BIT-PERFECT est actif.</string>
    <string name="eq_crossfade_label">CROSSFADE</string>
    <string name="eq_crossfade_desc">Superpose le fondu de sortie de la chanson actuelle avec le fondu d\'entrée de la suivante lors des changements automatiques de piste — différent du GAPLESS, qui se contente de retirer les silences sans superposition.</string>

    <string name="eq_delete_short">SUPPRIMER</string>
    <string name="eq_song_preset_saved">Cette chanson : préréglage « %1$s » enregistré</string>
    <string name="eq_song_no_preset">Cette chanson n\'a pas encore de préréglage enregistré — choisissez-en un ci-dessus</string>
    <string name="eq_song_replaygain_saved">Cette chanson : %1$s dB enregistrés</string>
    <string name="eq_song_replaygain_measuring">Cette chanson n\'a pas encore été mesurée — mesure en cours pendant la lecture</string>
    <string name="eq_crossfade_duration_label">Durée de chevauchement :</string>
    <string name="eq_crossfade_seconds_unit">%1$dS</string>
    <string name="eq_offload_active">OFFLOAD matériel ACTIF — cette chanson utilise réellement le chemin direct vers le DAC.</string>
    <string name="eq_offload_inactive">OFFLOAD non actif pour cette chanson — retour automatique au contournement logiciel (toujours bit-perfect).</string>
    <string name="eq_rocker_off">ARRÊT</string>
    <string name="eq_rocker_on">MARCHE</string>

    <string name="eq_vocal_subtitle">GRAVES / AIGUS DE VOIX</string>
    <string name="eq_vocal_toggle_desc">Active l\'amélioration vocale — deux filtres dédiés (corps ~200Hz et clarté ~4,5kHz) distincts de l\'égaliseur 10 bandes de l\'onglet ÉGAL, pour que la voix ressorte sans changer le préréglage actif.</string>
    <string name="eq_vocal_bass_knob">GRAVES VOIX</string>
    <string name="eq_vocal_treble_knob">AIGUS VOIX</string>
    <string name="eq_vocal_description">GRAVES VOIX ajoute de la chaleur vocale (~200Hz), AIGUS VOIX ajoute de la clarté/articulation (~4,5kHz) — les deux indépendants des GRAVES/AIGUS de l\'onglet TONALITÉ.</string>

    <string name="eq_stereo_subtitle">BALANCE / EXPANSION / MONO</string>
    <string name="eq_balance_knob">BALANCE</string>
    <string name="eq_stereo_expansion_knob">EXPANSION STÉRÉO</string>
    <string name="eq_mono_stereo_label">MONO / STÉRÉO</string>
    <string name="eq_mono_stereo_desc">Lorsqu\'activé, les canaux gauche et droit sont combinés en mono (L+R identique sur les deux canaux) — remplace toujours l\'Expansion Stéréo. Lorsque désactivé, l\'image stéréo d\'origine ou le résultat de l\'Expansion Stéréo est utilisé.</string>
    <string name="eq_stereo_description">BALANCE modifie le volume relatif gauche/droite. EXPANSION STÉRÉO élargit (&gt;100%%) ou resserre (&lt;100%%) l\'image stéréo via un traitement Mid/Side, 0%% équivaut au mono total.</string>

    <string name="eq_save_dialog_title">ENREGISTRER LE PRÉRÉGLAGE EQ</string>
    <string name="eq_preset_name_label">Nom du préréglage</string>
    <string name="eq_save_button">ENREGISTRER</string>
    <string name="eq_cancel_button">ANNULER</string>
    <string name="eq_delete_preset_title">SUPPRIMER LE PRÉRÉGLAGE ?</string>
    <string name="eq_delete_preset_body">Le préréglage personnalisé « %1$s » sera définitivement supprimé et ne pourra pas être restauré. Les préréglages intégrés (Flat/Rock/Pop/Jazz/etc.) ne sont pas concernés.</string>
