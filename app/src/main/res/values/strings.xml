    <string name="eq_tone_subtitle">PREAMP / BASS / TREBLE</string>
    <string name="eq_preamp_slider_label">PREAMP</string>
    <string name="eq_bass_slider_label">BASS</string>
    <string name="eq_treble_slider_label">TREBLE</string>
    <string name="eq_tone_description">Preamp controls overall gain before the 10-band EQ. The Bass/Treble sliders here are a shortcut straight to the 31Hz &amp; 16kHz bands — use the EQU tab for full 10-band control.</string>

    <string name="eq_limit_subtitle">SOFT LIMITER</string>
    <string name="eq_soft_limiter_label">SOFT LIMITER</string>
    <string name="eq_soft_limiter_desc">Gently holds back signal peaks (soft-knee, threshold around -0.9 dBFS) so large EQ boosts don’t hard-clip.</string>
    <string name="eq_bypass_label">EQ BYPASS</string>
    <string name="eq_bypass_desc">Temporarily turns off all 10-band EQ processing (preamp &amp; bands stay saved — turn it back on anytime).</string>
    <string name="eq_bitperfect_label">BIT-PERFECT MODE</string>
    <string name="eq_bitperfect_desc">Skips ALL software signal processing (EQ, Vocal, Balance, Stereo Expansion, Mono, Limiter) AND requests a hardware AUDIO OFFLOAD path to the connected device/USB DAC. Other knob positions don’t change, just temporarily frozen. Offload support depends on the device &amp; song format — if unsupported, it automatically falls back to the software bypass (still fully functional).</string>
    <string name="eq_autoeq_label">AUTO EQ PER SONG</string>
    <string name="eq_autoeq_desc">Remembers the EQ preset picked for each song, then re-applies it automatically the next time that song plays — no need to switch presets manually every time.</string>
    <string name="eq_replaygain_label">REPLAY GAIN</string>
    <string name="eq_replaygain_desc">Automatically measures &amp; matches loudness across songs — a song that hasn’t been measured yet gets measured while you listen, then the gain is remembered for next time. Automatically disabled while BIT-PERFECT MODE is on.</string>
    <string name="eq_crossfade_label">CROSSFADE</string>
    <string name="eq_crossfade_desc">Overlaps the current song’s fade-out with the next song’s fade-in on automatic track changes — different from GAPLESS, which just removes silence with no overlap.</string>

    <!-- BARU (patch "headroom slider") -->
    <string name="eq_headroom_safety_label">MAX LOUDNESS ↔ SAFE HEADROOM</string>
    <string name="eq_headroom_safety_desc">Lower = louder overall, but the limiter kicks in more often on EQ presets with big/overlapping boosts. Higher = safer headroom, but quieter for those same presets.</string>

    <string name="eq_delete_short">DELETE</string>
    <string name="eq_song_preset_saved">This song: preset “%1$s” saved</string>
    <string name="eq_song_no_preset">This song has no saved preset yet — pick a preset above</string>
    <string name="eq_song_replaygain_saved">This song: %1$s dB saved</string>
    <string name="eq_song_replaygain_measuring">This song hasn’t been measured yet — measuring while it plays</string>
    <string name="eq_crossfade_duration_label">Overlap duration:</string>
    <string name="eq_crossfade_seconds_unit">%1$dS</string>
    <string name="eq_offload_active">OFFLOAD hardware ACTIVE — this song is genuinely using the direct-path route to the DAC.</string>
    <string name="eq_offload_inactive">OFFLOAD not active for this song — automatically falling back to software bypass (still bit-perfect).</string>
    <string name="eq_rocker_off">OFF</string>
    <string name="eq_rocker_on">ON</string>

    <string name="eq_vocal_subtitle">VOCAL BASS / TREBLE</string>
    <string name="eq_vocal_toggle_desc">Turns on vocal enhancement — two dedicated filters (body ~200Hz &amp; clarity ~4.5kHz) separate from the 10-band EQ in the EQU tab, so vocals stand out without changing the active preset.</string>
    <string name="eq_vocal_bass_knob">VOCAL BASS</string>
    <string name="eq_vocal_treble_knob">VOCAL TREBLE</string>
    <string name="eq_vocal_description">VOCAL BASS adds vocal warmth (~200Hz), VOCAL TREBLE adds clarity/articulation (~4.5kHz) — both independent from BASS/TREBLE in the TONE tab.</string>

    <string name="eq_stereo_subtitle">BALANCE / EXPANSION / MONO</string>
    <string name="eq_balance_knob">BALANCE</string>
    <string name="eq_stereo_expansion_knob">STEREO EXPANSION</string>
    <string name="eq_mono_stereo_label">MONO / STEREO</string>
    <string name="eq_mono_stereo_desc">When ON, left &amp; right channels are combined into mono (identical L+R on both channels) — always overrides Stereo Expansion. When OFF, the original stereo image or Stereo Expansion result is used.</string>
    <string name="eq_stereo_description">BALANCE shifts relative left/right volume. STEREO EXPANSION widens (&gt;100%%) or narrows (&lt;100%%) the stereo image via Mid/Side processing, 0%% equals full mono.</string>

