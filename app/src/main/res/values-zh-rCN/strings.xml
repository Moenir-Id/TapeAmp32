    <string name="eq_song_no_preset">此歌曲尚无已保存的预设 — 请在上方选择一个预设</string>
    <string name="eq_song_replaygain_saved">此歌曲：已保存 %1$s dB</string>
    <string name="eq_song_replaygain_measuring">此歌曲尚未测量 — 正在播放过程中测量</string>
    <string name="eq_crossfade_duration_label">重叠时长：</string>
    <string name="eq_crossfade_seconds_unit">%1$d秒</string>
    <string name="eq_offload_active">硬件OFFLOAD 已启用 — 此歌曲正在真正使用直通DAC的路径。</string>
    <string name="eq_offload_inactive">此歌曲未启用OFFLOAD — 已自动回退到软件旁通（依然是比特完美的）。</string>
    <string name="eq_rocker_off">关</string>
    <string name="eq_rocker_on">开</string>

    <string name="eq_vocal_subtitle">人声低音 / 高音</string>
    <string name="eq_vocal_toggle_desc">开启人声增强 — 两个独立于EQU标签页10段均衡器的专用滤波器（音质~200Hz，清晰度~4.5kHz），可在不改变当前预设的情况下让人声更突出。</string>
    <string name="eq_vocal_bass_knob">人声低音</string>
    <string name="eq_vocal_treble_knob">人声高音</string>
    <string name="eq_vocal_description">人声低音增添人声温暖感（~200Hz），人声高音增添清晰度/咬字感（~4.5kHz） — 两者均独立于音色标签页中的低音/高音。</string>

    <string name="eq_stereo_subtitle">平衡 / 扩展 / 单声道</string>
    <string name="eq_balance_knob">平衡</string>
    <string name="eq_stereo_expansion_knob">立体声扩展</string>
    <string name="eq_mono_stereo_label">单声道 / 立体声</string>
    <string name="eq_mono_stereo_desc">开启时，左右声道会合并为单声道（两个声道上的L+R相同） — 始终优先于立体声扩展。关闭时，将使用原始立体声效果或立体声扩展的结果。</string>
