<?xml version="1.0" encoding="utf-8"?>
<!--
    BARU (fitur "share card"): expose app cache dir khusus buat file share card
    PNG lewat FileProvider, supaya bisa dibagi ke app lain (share sheet) tanpa
    minta permission storage tambahan.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="share_cards" path="share_cards/" />
</paths>
