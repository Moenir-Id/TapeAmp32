<?xml version="1.0" encoding="utf-8"?>
<!--
    BARU (v2.3, Widget Home Screen). updatePeriodMillis SENGAJA 0 (bukan andalkan
    siklus refresh bawaan Android yang minimal 30 menit sekali - terlalu jarang
    untuk kontrol musik). Widget di-refresh SEGERA lewat
    PlayerWidgetProvider.updateAll() yang dipanggil dari PlaybackService setiap
    kali status playback/lagu berubah - lihat komentar di PlaybackService.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="90dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_player"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
