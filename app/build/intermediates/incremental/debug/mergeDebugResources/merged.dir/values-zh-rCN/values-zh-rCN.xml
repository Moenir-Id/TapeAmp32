    <string name="eq_song_replaygain_saved">此歌曲：已保存 %1$s dB</string>
    <string name="eq_stereo_description">平衡用于调整左右相对音量。立体声扩展通过Mid/Side处理来拓宽（>100%%）或收窄（&lt;100%%）立体声效果，0%%相当于完全单声道。</string>
    <string name="eq_stereo_expansion_knob">立体声扩展</string>
