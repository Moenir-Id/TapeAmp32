    <string name="eq_autoeq_desc">记住为每首歌曲选择的均衡器预设，并在下次播放该歌曲时自动重新应用 — 无需每次手动切换预设。</string>
    <string name="eq_autoeq_label">按曲目自动均衡</string>
    <string name="eq_balance_knob">平衡</string>
    <string name="eq_bass_slider_label">低音</string>
    <string name="eq_bitperfect_desc">跳过所有软件信号处理（均衡器、人声、平衡、立体声扩展、单声道、限幅器），并向已连接的设备/USB DAC请求硬件AUDIO OFFLOAD直通路径。其他旋钮位置不会改变，只是暂时冻结。是否支持直通取决于设备和歌曲格式 — 如不支持，将自动回退到软件旁通（功能依然完整）。</string>
    <string name="eq_bitperfect_label">比特完美模式</string>
    <string name="eq_bypass_desc">暂时关闭全部10段均衡器处理（前置放大和各频段设置仍会保存 — 可随时重新开启）。</string>
    <string name="eq_bypass_label">均衡器旁通</string>
    <string name="eq_cancel_button">取消</string>
    <string name="eq_crossfade_desc">在自动切换曲目时，将当前歌曲的淡出与下一首歌曲的淡入重叠 — 这与仅去除静音、不产生重叠的无缝播放（GAPLESS）不同。</string>
    <string name="eq_crossfade_duration_label">重叠时长：</string>
    <string name="eq_crossfade_label">交叉淡入淡出</string>
    <string name="eq_crossfade_seconds_unit">%1$d秒</string>
    <string name="eq_delete_button">删除</string>
    <string name="eq_delete_preset_body">自定义预设“%1$s”将被永久删除且无法恢复。内置预设（平坦/摇滚/流行/爵士等）不受影响。</string>
    <string name="eq_delete_preset_desc">删除预设 %1$s</string>
    <string name="eq_delete_preset_title">删除预设？</string>
    <string name="eq_delete_short">删除</string>
    <string name="eq_export_action">导出</string>
    <string name="eq_graphic_equalizer_header">图形均衡器</string>
    <string name="eq_header_preset_label">预设</string>
    <string name="eq_header_title">均衡器</string>
    <string name="eq_limit_subtitle">软限幅器</string>
    <string name="eq_lr_label">左 / 右</string>
    <string name="eq_mono_stereo_desc">开启时，左右声道会合并为单声道（两个声道上的L+R相同） — 始终优先于立体声扩展。关闭时，将使用原始立体声效果或立体声扩展的结果。</string>
    <string name="eq_mono_stereo_label">单声道 / 立体声</string>
    <string name="eq_offload_active">硬件OFFLOAD 已启用 — 此歌曲正在真正使用直通DAC的路径。</string>
    <string name="eq_offload_inactive">此歌曲未启用OFFLOAD — 已自动回退到软件旁通（依然是比特完美的）。</string>
    <string name="eq_preamp_slider_label">前置放大</string>
    <string name="eq_preset_name_label">预设名称</string>
    <string name="eq_replaygain_desc">自动测量并统一各歌曲之间的音量 — 尚未测量的歌曲会在播放时被测量，之后增益值会被记住以供下次使用。比特完美模式开启时会自动禁用。</string>
    <string name="eq_replaygain_label">回放增益</string>
    <string name="eq_rocker_off">关</string>
    <string name="eq_rocker_on">开</string>
    <string name="eq_save_button">保存</string>
    <string name="eq_save_dialog_title">保存均衡器预设</string>
    <string name="eq_soft_limiter_desc">温和地抑制信号峰值（软拐点，阈值约为-0.9 dBFS），使较大的均衡增益不会造成硬削波。</string>
    <string name="eq_soft_limiter_label">软限幅器</string>
    <string name="eq_song_no_preset">此歌曲尚无已保存的预设 — 请在上方选择一个预设</string>
