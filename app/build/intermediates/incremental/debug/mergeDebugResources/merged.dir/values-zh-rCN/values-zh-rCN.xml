    <string name="eq_tab_vocal">人声</string>
    <string name="eq_tone_description">前置放大控制10段均衡器之前的整体增益。这里的低音/高音滑块是直接通向31Hz和16kHz频段的快捷方式 — 使用EQU标签页可进行完整的10段调节。</string>
    <string name="eq_tone_subtitle">前置放大 / 低音 / 高音</string>
    <string name="eq_treble_slider_label">高音</string>
    <string name="eq_upload_action">上传</string>
    <string name="eq_vocal_bass_knob">人声低音</string>
    <string name="eq_vocal_description">人声低音增添人声温暖感（~200Hz），人声高音增添清晰度/咬字感（~4.5kHz） — 两者均独立于音色标签页中的低音/高音。</string>
    <string name="eq_vocal_subtitle">人声低音 / 高音</string>
    <string name="eq_vocal_toggle_desc">开启人声增强 — 两个独立于EQU标签页10段均衡器的专用滤波器（音质~200Hz，清晰度~4.5kHz），可在不改变当前预设的情况下让人声更突出。</string>
    <string name="eq_vocal_treble_knob">人声高音</string>
