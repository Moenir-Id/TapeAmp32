    <string name="eq_song_replaygain_saved">이 곡: %1$s dB 저장됨</string>
    <string name="eq_stereo_description">밸런스는 좌우 상대 음량을 이동시킵니다. 스테레오 확장은 Mid/Side 처리로 스테레오 이미지를 넓히거나(>100%%) 좁힙니다(&lt;100%%). 0%%는 완전한 모노와 같습니다.</string>
    <string name="eq_stereo_expansion_knob">스테레오 확장</string>
    <string name="eq_stereo_subtitle">밸런스 / 확장 / 모노</string>
