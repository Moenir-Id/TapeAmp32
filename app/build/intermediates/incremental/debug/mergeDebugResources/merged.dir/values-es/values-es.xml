    <string name="eq_10_band">10 BANDAS</string>
    <string name="eq_autoeq_desc">Recuerda el preajuste de ecualizador elegido para cada canción y lo vuelve a aplicar automáticamente la próxima vez que se reproduzca — sin necesidad de cambiar de preajuste manualmente cada vez.</string>
    <string name="eq_autoeq_label">AUTO EQ POR CANCIÓN</string>
    <string name="eq_balance_knob">BALANCE</string>
    <string name="eq_bass_slider_label">GRAVES</string>
    <string name="eq_bitperfect_desc">Omite TODO el procesamiento de señal por software (EQ, Voz, Balance, Expansión Estéreo, Mono, Limitador) Y solicita una ruta de AUDIO OFFLOAD por hardware al dispositivo/DAC USB conectado. Las demás posiciones no cambian, solo quedan temporalmente congeladas. El soporte de offload depende del dispositivo y del formato de la canción — si no es compatible, vuelve automáticamente al bypass por software (sigue siendo totalmente funcional).</string>
    <string name="eq_bitperfect_label">MODO BIT-PERFECTO</string>
    <string name="eq_bypass_desc">Desactiva temporalmente todo el procesamiento del ecualizador de 10 bandas (el preamp y las bandas permanecen guardados — actívalo de nuevo cuando quieras).</string>
    <string name="eq_bypass_label">OMITIR EQ</string>
    <string name="eq_cancel_button">CANCELAR</string>
    <string name="eq_crossfade_desc">Superpone el desvanecimiento de salida de la canción actual con el de entrada de la siguiente en los cambios automáticos de pista — diferente de GAPLESS, que solo elimina el silencio sin superposición.</string>
    <string name="eq_crossfade_duration_label">Duración de la superposición:</string>
    <string name="eq_crossfade_label">CROSSFADE</string>
    <string name="eq_crossfade_seconds_unit">%1$dS</string>
    <string name="eq_delete_button">ELIMINAR</string>
    <string name="eq_delete_preset_body">El preajuste personalizado “%1$s” se eliminará permanentemente y no se podrá restaurar. Los preajustes integrados (Plano/Rock/Pop/Jazz/etc.) no se ven afectados.</string>
    <string name="eq_delete_preset_desc">Eliminar preajuste %1$s</string>
    <string name="eq_delete_preset_title">¿ELIMINAR PREAJUSTE?</string>
    <string name="eq_delete_short">ELIMINAR</string>
    <string name="eq_export_action">EXPORTAR</string>
    <string name="eq_graphic_equalizer_header">ECUALIZADOR GRÁFICO</string>
    <string name="eq_header_preset_label">PREAJUSTE</string>
    <string name="eq_header_title">ECUALIZADOR</string>
    <string name="eq_limit_subtitle">LIMITADOR SUAVE</string>
    <string name="eq_lr_label">I / D</string>
    <string name="eq_mono_stereo_desc">Cuando está ACTIVADO, los canales izquierdo y derecho se combinan en mono (L+R idéntico en ambos canales) — siempre anula la Expansión Estéreo. Cuando está DESACTIVADO, se usa la imagen estéreo original o el resultado de la Expansión Estéreo.</string>
    <string name="eq_mono_stereo_label">MONO / ESTÉREO</string>
    <string name="eq_offload_active">OFFLOAD por hardware ACTIVO — esta canción realmente usa la ruta directa al DAC.</string>
    <string name="eq_offload_inactive">OFFLOAD no activo para esta canción — volviendo automáticamente al bypass por software (sigue siendo bit-perfecto).</string>
    <string name="eq_preamp_slider_label">PREAMP</string>
    <string name="eq_preset_name_label">Nombre del preajuste</string>
    <string name="eq_replaygain_desc">Mide y equipara automáticamente el volumen entre canciones — una canción que aún no se ha medido se mide mientras la escuchas, y luego se recuerda la ganancia para la próxima vez. Se desactiva automáticamente mientras el MODO BIT-PERFECTO está activado.</string>
    <string name="eq_replaygain_label">REPLAY GAIN</string>
    <string name="eq_rocker_off">APAGADO</string>
    <string name="eq_rocker_on">ENCENDIDO</string>
    <string name="eq_save_button">GUARDAR</string>
    <string name="eq_save_dialog_title">GUARDAR PREAJUSTE DE EQ</string>
    <string name="eq_soft_limiter_desc">Contiene suavemente los picos de señal (soft-knee, umbral cerca de -0.9 dBFS) para que los grandes aumentos del ecualizador no recorten bruscamente.</string>
    <string name="eq_soft_limiter_label">LIMITADOR SUAVE</string>
    <string name="eq_song_no_preset">Esta canción aún no tiene un preajuste guardado — elige uno arriba</string>
    <string name="eq_song_preset_saved">Esta canción: preajuste “%1$s” guardado</string>
    <string name="eq_song_replaygain_measuring">Esta canción aún no se ha medido — midiendo mientras se reproduce</string>
    <string name="eq_song_replaygain_saved">Esta canción: %1$s dB guardados</string>
    <string name="eq_stereo_description">BALANCE desplaza el volumen relativo entre izquierda y derecha. EXPANSIÓN ESTÉREO amplía (>100%%) o estrecha (&lt;100%%) la imagen estéreo mediante procesamiento Mid/Side, 0%% equivale a mono total.</string>
    <string name="eq_stereo_expansion_knob">EXPANSIÓN ESTÉREO</string>
    <string name="eq_stereo_subtitle">BALANCE / EXPANSIÓN / MONO</string>
    <string name="eq_tab_equ">ECU</string>
    <string name="eq_tab_limit">LÍMITE</string>
    <string name="eq_tab_stereo">ESTÉREO</string>
    <string name="eq_tab_tone">TONO</string>
    <string name="eq_tab_vocal">VOZ</string>
    <string name="eq_tone_description">El Preamp controla la ganancia general antes del ecualizador de 10 bandas. Los deslizadores de Graves/Agudos aquí son un acceso directo a las bandas de 31Hz y 16kHz — usa la pestaña ECU para el control completo de 10 bandas.</string>
    <string name="eq_tone_subtitle">PREAMP / GRAVES / AGUDOS</string>
    <string name="eq_treble_slider_label">AGUDOS</string>
    <string name="eq_upload_action">SUBIR</string>
    <string name="eq_vocal_bass_knob">GRAVES DE VOZ</string>
    <string name="eq_vocal_description">GRAVES DE VOZ añade calidez vocal (~200Hz), AGUDOS DE VOZ añade claridad/articulación (~4.5kHz) — ambos independientes de GRAVES/AGUDOS en la pestaña TONO.</string>
    <string name="eq_vocal_subtitle">GRAVES / AGUDOS DE VOZ</string>
    <string name="eq_vocal_toggle_desc">Activa el realce de voz — dos filtros dedicados (cuerpo ~200Hz y claridad ~4.5kHz) independientes del ecualizador de 10 bandas de la pestaña ECU, para que la voz resalte sin cambiar el preajuste activo.</string>
    <string name="eq_vocal_treble_knob">AGUDOS DE VOZ</string>
    <string name="eq_vu_level">NIVEL</string>
