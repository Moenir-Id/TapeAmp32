    <string name="eq_10_band">10 BANDAS</string>
    <string name="eq_autoeq_desc">Lembra a predefinição de EQ escolhida para cada música e a reaplica automaticamente na próxima vez que ela tocar — sem precisar trocar de predefinição manualmente toda vez.</string>
    <string name="eq_autoeq_label">AUTO EQ POR MÚSICA</string>
    <string name="eq_balance_knob">BALANÇO</string>
    <string name="eq_bass_slider_label">GRAVES</string>
    <string name="eq_bitperfect_desc">Ignora TODO o processamento de sinal por software (EQ, Vocal, Balanço, Expansão Estéreo, Mono, Limitador) E solicita um caminho de ÁUDIO OFFLOAD por hardware para o dispositivo/DAC USB conectado. As demais posições não mudam, apenas ficam temporariamente congeladas. O suporte a offload depende do dispositivo e do formato da música — se não for suportado, volta automaticamente ao bypass por software (ainda totalmente funcional).</string>
    <string name="eq_bitperfect_label">MODO BIT-PERFECT</string>
    <string name="eq_bypass_desc">Desativa temporariamente todo o processamento do EQ de 10 bandas (pré-amp e bandas permanecem salvos — reative quando quiser).</string>
    <string name="eq_bypass_label">BYPASS DE EQ</string>
    <string name="eq_cancel_button">CANCELAR</string>
    <string name="eq_crossfade_desc">Sobrepõe o fade-out da música atual com o fade-in da próxima nas trocas automáticas de faixa — diferente do GAPLESS, que apenas remove o silêncio sem sobreposição.</string>
    <string name="eq_crossfade_duration_label">Duração da sobreposição:</string>
    <string name="eq_crossfade_label">CROSSFADE</string>
    <string name="eq_crossfade_seconds_unit">%1$dS</string>
    <string name="eq_delete_button">EXCLUIR</string>
    <string name="eq_delete_preset_body">A predefinição personalizada “%1$s” será excluída permanentemente e não poderá ser restaurada. As predefinições integradas (Flat/Rock/Pop/Jazz/etc.) não são afetadas.</string>
    <string name="eq_delete_preset_desc">Excluir predefinição %1$s</string>
    <string name="eq_delete_preset_title">EXCLUIR PREDEFINIÇÃO?</string>
    <string name="eq_delete_short">EXCLUIR</string>
    <string name="eq_export_action">EXPORTAR</string>
    <string name="eq_graphic_equalizer_header">EQUALIZADOR GRÁFICO</string>
    <string name="eq_header_preset_label">PREDEFINIÇÃO</string>
    <string name="eq_header_title">EQUALIZADOR</string>
    <string name="eq_limit_subtitle">LIMITADOR SUAVE</string>
    <string name="eq_lr_label">E / D</string>
    <string name="eq_mono_stereo_desc">Quando LIGADO, os canais esquerdo e direito são combinados em mono (L+R idêntico em ambos os canais) — sempre substitui a Expansão Estéreo. Quando DESLIGADO, é usada a imagem estéreo original ou o resultado da Expansão Estéreo.</string>
    <string name="eq_mono_stereo_label">MONO / ESTÉREO</string>
    <string name="eq_offload_active">OFFLOAD de hardware ATIVO — esta música está realmente usando o caminho direto até o DAC.</string>
    <string name="eq_offload_inactive">OFFLOAD não ativo para esta música — voltando automaticamente ao bypass por software (ainda bit-perfect).</string>
    <string name="eq_preamp_slider_label">PRÉ-AMP</string>
    <string name="eq_preset_name_label">Nome da predefinição</string>
    <string name="eq_replaygain_desc">Mede e equipara automaticamente o volume entre as músicas — uma música ainda não medida é medida enquanto você ouve, e o ganho é lembrado para a próxima vez. Desativado automaticamente enquanto o MODO BIT-PERFECT está ativo.</string>
    <string name="eq_replaygain_label">REPLAY GAIN</string>
    <string name="eq_rocker_off">DESLIGADO</string>
    <string name="eq_rocker_on">LIGADO</string>
    <string name="eq_save_button">SALVAR</string>
    <string name="eq_save_dialog_title">SALVAR PREDEFINIÇÃO DE EQ</string>
    <string name="eq_soft_limiter_desc">Contém suavemente os picos de sinal (soft-knee, limiar próximo de -0,9 dBFS) para que grandes reforços de EQ não cortem bruscamente.</string>
    <string name="eq_soft_limiter_label">LIMITADOR SUAVE</string>
    <string name="eq_song_no_preset">Esta música ainda não tem predefinição salva — escolha uma acima</string>
    <string name="eq_song_preset_saved">Esta música: predefinição “%1$s” salva</string>
    <string name="eq_song_replaygain_measuring">Esta música ainda não foi medida — medindo enquanto toca</string>
    <string name="eq_song_replaygain_saved">Esta música: %1$s dB salvos</string>
    <string name="eq_stereo_description">BALANÇO desloca o volume relativo entre esquerda e direita. EXPANSÃO ESTÉREO amplia (>100%%) ou estreita (&lt;100%%) a imagem estéreo por processamento Mid/Side, 0%% equivale a mono total.</string>
    <string name="eq_stereo_expansion_knob">EXPANSÃO ESTÉREO</string>
    <string name="eq_stereo_subtitle">BALANÇO / EXPANSÃO / MONO</string>
    <string name="eq_tab_equ">EQU</string>
    <string name="eq_tab_limit">LIMITE</string>
    <string name="eq_tab_stereo">ESTÉREO</string>
    <string name="eq_tab_tone">TOM</string>
    <string name="eq_tab_vocal">VOCAL</string>
    <string name="eq_tone_description">O Pré-amp controla o ganho geral antes do EQ de 10 bandas. Os controles de Graves/Agudos aqui são um atalho direto para as bandas de 31Hz e 16kHz — use a aba EQU para controle completo de 10 bandas.</string>
    <string name="eq_tone_subtitle">PRÉ-AMP / GRAVES / AGUDOS</string>
    <string name="eq_treble_slider_label">AGUDOS</string>
    <string name="eq_upload_action">ENVIAR</string>
    <string name="eq_vocal_bass_knob">GRAVES VOCAIS</string>
    <string name="eq_vocal_description">GRAVES VOCAIS adiciona calor vocal (~200Hz), AGUDOS VOCAIS adiciona clareza/articulação (~4,5kHz) — ambos independentes de GRAVES/AGUDOS na aba TOM.</string>
    <string name="eq_vocal_subtitle">GRAVES / AGUDOS VOCAIS</string>
    <string name="eq_vocal_toggle_desc">Ativa o realce vocal — dois filtros dedicados (corpo ~200Hz e clareza ~4,5kHz) separados do EQ de 10 bandas na aba EQU, para que os vocais se destaquem sem alterar a predefinição ativa.</string>
    <string name="eq_vocal_treble_knob">AGUDOS VOCAIS</string>
    <string name="eq_vu_level">NÍVEL</string>
