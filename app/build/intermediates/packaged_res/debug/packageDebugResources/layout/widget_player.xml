<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout ini WAJIB cuma pakai View yang didukung RemoteViews (LinearLayout/
    FrameLayout, TextView, ImageView, ProgressBar, dst) - tidak bisa pakai
    Composable apa pun dari layar-layar lain di app ini.

    BARU (Widget "lebih cantik", revisi bentuk kaset asli): dibanding v2.3, sekarang
    ada ImageView kaset (badan cangkang + dua reel kiri kanan) yang "berputar" (lihat
    ic_widget_reel_0..7 & PlaybackService.widgetTickRunnable) di samping judul/artis,
    dan ProgressBar tipis yang menampilkan posisi lagu berjalan (lihat
    widget_seekbar_progress.xml untuk batasan jujurnya: visual saja, belum bisa
    di-drag).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_reel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_widget_reel_0"
            android:contentDescription="@string/widget_reel_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="TapeAmp 32" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-- Tidak ada lagu diputar --" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_seekbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_seekbar_progress"
        android:contentDescription="@string/widget_no_song" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/widget_prev_desc" />

        <ImageView
            android:id="@+id/widget_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="8dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/widget_play_pause_desc" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/widget_next_desc" />

    </LinearLayout>

</LinearLayout>
