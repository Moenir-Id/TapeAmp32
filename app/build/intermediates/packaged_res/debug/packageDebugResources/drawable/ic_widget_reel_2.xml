<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget "kaset berputar" (revisi 2: samain dengan kaset di CassetteDeck.kt
    layar Player, bukan cuma bentuk kaset generik). Frame ke-2 dari 8 (rotasi
    90 derajat), dipilih PlayerWidgetProvider.buildRemoteViews() berdasar
    waktu sistem berjalan setiap widget di-refresh (lihat
    PlaybackService.widgetTickRunnable).
    RemoteViews tidak bisa menganimasikan drawable sendiri, jadi "berputar"-nya
    disimulasikan lewat pergantian frame statis ini.
    Elemen yang disamakan dengan reel di CassetteDeck.kt (drawReel()): hub
    reel yang berputar terpisah dari jendela reel yang diam, ENAM gigi reel
    pendek dekat hub (bukan 3 jari-jari panjang ke tepi seperti revisi
    sebelumnya), dan garis pita tipis penghubung kedua reel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Badan cangkang kaset, diam -->
    <path
        android:strokeColor="@color/widget_gold"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M4,6 L20,6 A2,2 0 0,1 22,8 L22,16 A2,2 0 0,1 20,18 L4,18 A2,2 0 0,1 2,16 L2,8 A2,2 0 0,1 4,6 Z" />

    <!-- Jendela reel kiri & kanan (setara "TAPE WINDOW" di CassetteDeck.kt), diam -->
    <path
        android:strokeColor="@color/widget_gold"
        android:strokeWidth="1"
        android:fillColor="#00000000"
        android:pathData="M4,12 A3.5,3.5 0 1,0 11,12 A3.5,3.5 0 1,0 4,12" />
    <path
        android:strokeColor="@color/widget_gold"
        android:strokeWidth="1"
        android:fillColor="#00000000"
        android:pathData="M13,12 A3.5,3.5 0 1,0 20,12 A3.5,3.5 0 1,0 13,12" />

    <!-- Garis pita tipis penghubung kedua reel (setara "SUBTLE TAPE HIGHLIGHT") -->
    <path
        android:strokeColor="@color/widget_text_muted"
        android:strokeWidth="0.7"
        android:fillColor="#00000000"
        android:pathData="M11,12 L13,12" />

    <!-- Hub reel kiri: berputar (setara "OUTER METAL/PLASTIC RING" + gigi) -->
    <group
        android:name="reel_left_frame_2"
        android:pivotX="7.5"
        android:pivotY="12"
        android:rotation="90">
        <path
            android:fillColor="@color/widget_gold"
            android:pathData="M7.5,12 m-1.3,0 a1.3,1.3 0 1,1 2.6,0 a1.3,1.3 0 1,1 -2.6,0" />
        <path
            android:strokeColor="@color/widget_bg"
            android:strokeWidth="0.6"
            android:fillColor="#00000000"
            android:pathData="M7.5,11.45 L7.5,10.95 M7.976,11.725 L8.409,11.475 M7.976,12.275 L8.409,12.525 M7.5,12.55 L7.5,13.05 M7.024,12.275 L6.591,12.525 M7.024,11.725 L6.591,11.475" />
    </group>

    <!-- Hub reel kanan: berputar, arah & kecepatan sama dengan kiri -->
    <group
        android:name="reel_right_frame_2"
        android:pivotX="16.5"
        android:pivotY="12"
        android:rotation="90">
        <path
            android:fillColor="@color/widget_gold"
            android:pathData="M16.5,12 m-1.3,0 a1.3,1.3 0 1,1 2.6,0 a1.3,1.3 0 1,1 -2.6,0" />
        <path
            android:strokeColor="@color/widget_bg"
            android:strokeWidth="0.6"
            android:fillColor="#00000000"
            android:pathData="M16.5,11.45 L16.5,10.95 M16.976,11.725 L17.409,11.475 M16.976,12.275 L17.409,12.525 M16.5,12.55 L16.5,13.05 M16.024,12.275 L15.591,12.525 M16.024,11.725 L15.591,11.475" />
    </group>

</vector>
